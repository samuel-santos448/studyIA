[Unit]
Description=StudyIA
After=network.target postgresql.service

[Service]
Type=simple
User=studyia
Group=studyia
WorkingDirectory=/opt/studyia
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/studyia/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
