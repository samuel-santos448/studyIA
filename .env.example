OPENAI_API_KEY=
# Set a Responses API model available in your OpenAI project.
OPENAI_MODEL=
# Realtime voice model available in your OpenAI project.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
PORT=3000
NODE_ENV=development
# Required in production: HTTPS origin, without a trailing slash.
PUBLIC_ORIGIN=

# Audio assessment; credentials remain only on the server.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Future OIDC adapter configuration. Corporate sign-in is not enabled yet.
AUTH_PROVIDER=local
ENTRA_TENANT_ID=
AUTH_CLIENT_ID=
AUTH_REDIRECT_URI=
OIDC_ISSUER=

# PostgreSQL. No SQLite fallback is used. Run npm run migrate before npm start.
DATABASE_URL=
# External hosts require verified TLS. Local development may leave this blank.
DATABASE_TLS=
# Optional CA certificate file for your PostgreSQL provider.
DATABASE_CA_FILE=
